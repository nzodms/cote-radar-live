// SupplierPilot — Prisma schema (PostgreSQL).
//
// The app uses the DB as source of truth when DATABASE_URL is set; otherwise it
// falls back to the in-memory/localStorage demo store. Models mirror
// types/index.ts so the data-access layer maps 1:1.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ShopConnection {
  id              String    @id @default("default")
  shopDomain      String    @unique
  apiVersion      String    @default("2026-04")
  ordersImported  Int       @default(0)
  productsImported Int      @default(0)
  lastSyncAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  syncRuns        SyncRun[]
  orders          Order[]
}

model SyncRun {
  id        String          @id @default(cuid())
  resource  String // "orders" | "products"
  status    String // "success" | "error"
  imported  Int             @default(0)
  updated   Int             @default(0)
  error     String?
  shop      ShopConnection? @relation(fields: [shopId], references: [id], onDelete: SetNull)
  shopId    String?
  createdAt DateTime        @default(now())

  @@index([resource, createdAt])
}

model Supplier {
  id               String          @id @default(cuid())
  name             String
  initials         String
  country          String
  countryCode      String
  specialty        String
  whatsappNumber   String
  language         String          @default("fr")
  reliabilityScore Int             @default(80)
  performance90d   Int             @default(80)
  averageDelayDays Int             @default(0)
  averageCost      Float           @default(0)
  totalOrders      Int             @default(0)
  totalPaid        Float           @default(0)
  incidents        Int             @default(0)
  tags             String[]
  notes            String          @default("")
  preferred        Boolean         @default(false)
  blocked          Boolean         @default(false)
  online           Boolean         @default(false)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  quotes           SupplierQuote[]
  conversations    Conversation[]
  purchases        Purchase[]
  selectedOrders   Order[]         @relation("SelectedSupplier")

  @@index([preferred])
  @@index([blocked])
}

model Order {
  id                   String          @id @default(cuid())
  shopifyOrderId       String?         @unique
  shopifyOrderNumber   String
  productName          String
  productImage         String
  variant              String          @default("")
  size                 String          @default("")
  color                String          @default("")
  quantity             Int             @default(1)
  country              String
  countryCode          String
  customerName         String          @default("")
  salePrice            Float
  currency             String          @default("EUR")
  targetMaxCost        Float
  status               String          @default("awaiting_reply")
  financialStatus      String?
  fulfillmentStatus    String?
  paymentStatus        String          @default("pending")
  trackingStatus       String          @default("none")
  trackingNumber       String?
  paymentDate          DateTime?
  expectedTrackingDate DateTime?
  recommendedSupplierId String?
  selectedSupplier     Supplier?       @relation("SelectedSupplier", fields: [selectedSupplierId], references: [id], onDelete: SetNull)
  selectedSupplierId   String?
  shop                 ShopConnection? @relation(fields: [shopId], references: [id], onDelete: SetNull)
  shopId               String?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  lineItems            OrderLineItem[]
  quotes               SupplierQuote[]
  conversations        Conversation[]
  purchase             Purchase?

  @@index([status])
  @@index([selectedSupplierId])
  @@index([createdAt])
}

model OrderLineItem {
  id           String   @id @default(cuid())
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId      String
  title        String
  variantTitle String?
  sku          String?
  quantity     Int      @default(1)
  price        Float
  image        String?
  productId    String?
  variantId    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([orderId])
}

model SupplierQuote {
  id               String   @id @default(cuid())
  order            Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId          String
  supplier         Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  supplierId       String
  productCost      Float
  shippingCost     Float
  totalCost        Float
  currency         String   @default("EUR")
  deliveryMinDays  Int
  deliveryMaxDays  Int
  stockStatus      String
  reliabilityScore Int
  performance90d   Int
  incidents        Int      @default(0)
  notes            String   @default("")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([orderId, supplierId])
  @@index([orderId])
}

model Conversation {
  id            String    @id @default(cuid())
  supplier      Supplier  @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  supplierId    String
  order         Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId       String
  unreadCount   Int       @default(0)
  status        String    @default("active")
  lastMessageAt DateTime  @default(now())
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  messages      Message[]

  @@unique([orderId, supplierId])
  @@index([orderId])
}

model Message {
  id             String       @id @default(cuid())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  conversationId String
  senderType     String // "merchant" | "supplier" | "system"
  content        String
  channel        String       @default("whatsapp")
  status         String?
  attachments    Json?
  quoteSnapshot  Json?
  timestamp      DateTime     @default(now())
  createdAt      DateTime     @default(now())

  @@index([conversationId])
  @@index([timestamp])
}

model Purchase {
  id                   String    @id @default(cuid())
  order                Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId              String    @unique
  supplier             Supplier  @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  supplierId           String
  amount               Float
  currency             String    @default("EUR")
  paymentStatus        String    @default("to_pay")
  paymentDate          DateTime?
  expectedTrackingDate DateTime?
  trackingNumber       String?
  status               String    @default("to_pay")
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([supplierId])
}

model AIRules {
  id                      String   @id @default("default")
  minimumMarginPercent    Int      @default(35)
  maximumDeliveryDays     Int      @default(15)
  manualValidationAbove   Float    @default(500)
  autoReminderHours       Int      @default(24)
  preferConfirmedStock    Boolean  @default(true)
  excludeReliabilityBelow Int      @default(70)
  preferredSupplierIds    String[]
  blockedSupplierIds      String[]
  allowedCountries        String[]
  weightPrice             Int      @default(30)
  weightDelay             Int      @default(20)
  weightReliability       Int      @default(20)
  weightStock             Int      @default(15)
  weightMargin            Int      @default(15)
  updatedAt               DateTime @updatedAt
}
