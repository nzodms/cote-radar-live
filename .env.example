# =========================================================================
# SupplierPilot — environment variables
# Copy to .env.local for local development. NEVER commit real keys.
# Every key is OPTIONAL for the V1 demo: without them the app runs fully on
# a mock AI layer, wa.me links, and in-memory demo data.
# =========================================================================

# --- AI (Claude) -----------------------------------------------------------
# If set, lib/ai/* call the real Claude API (server-side only). If empty,
# a deterministic mock AI layer is used so the demo always works offline.
ANTHROPIC_API_KEY=
# Model used for message generation / quote extraction.
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Shopify ---------------------------------------------------------------
# Used by the webhook adapter to verify payloads. Demo accepts unsigned bodies.
SHOPIFY_WEBHOOK_SECRET=
SHOPIFY_STORE_DOMAIN=
SHOPIFY_ADMIN_API_TOKEN=

# --- WhatsApp Cloud API ----------------------------------------------------
# If all three are set, lib/whatsapp/sendWhatsAppMessage uses the Cloud API
# adapter stub. Otherwise the app generates wa.me links + internal inbox sends.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_BUSINESS_ACCOUNT_ID=

# --- App -------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME=SupplierPilot
