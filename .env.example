# =========================================================================
# SupplierPilot — environment variables
# Copy to .env.local for local development. NEVER commit real keys.
# Every key is OPTIONAL: without them the app runs fully on a mock AI layer,
# wa.me links, and in-memory demo data ("Mode démo").
# =========================================================================

# --- Shopify (private / custom app) ---------------------------------------
# Server-side only. The Admin token is NEVER exposed to the browser.
# SHOPIFY_SHOP_DOMAIN accepts "my-store" or "my-store.myshopify.com".
SHOPIFY_SHOP_DOMAIN=
SHOPIFY_ADMIN_ACCESS_TOKEN=
SHOPIFY_API_VERSION=2026-04
# HMAC secret for the orders/create webhook. Without it the webhook runs in
# clearly-marked insecure dev mode.
SHOPIFY_WEBHOOK_SECRET=
# Optional: default supplier cost target as a ratio of sale price (default 0.38).
SUPPLIERPILOT_TARGET_COST_RATIO=0.38

# --- AI (Claude) -----------------------------------------------------------
# If set, lib/ai/* call the real Claude API (server-side only). If empty,
# a deterministic mock AI layer is used so the demo always works offline.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- WhatsApp Cloud API ----------------------------------------------------
# If all three are set, lib/whatsapp/sendWhatsAppMessage uses the Cloud API
# adapter. Otherwise the app generates wa.me links + internal inbox sends.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_BUSINESS_ACCOUNT_ID=

# --- App -------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME=SupplierPilot

# --- Database (Prisma + PostgreSQL) ----------------------------------------
# When set, the DB becomes the source of truth (orders, suppliers, quotes,
# conversations, messages, purchases, AI rules persist). When empty, the app
# runs entirely on the in-memory/localStorage demo store ("Mode démo").
# Example (Neon/Supabase/Vercel Postgres):
# postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require
DATABASE_URL=
