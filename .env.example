# ==========================================================
# CoteRadar Live - Variables d'environnement (exemple)
# Copier ce fichier en `.env.local` et remplir les valeurs.
# NE JAMAIS commiter le vrai .env / .env.local
# ==========================================================

# --- API-Football / API-SPORTS ---
# Clé API privée (plan Free = 100 requêtes / jour).
# Utilisée UNIQUEMENT côté serveur. Ne jamais l'exposer au client.
APISPORTS_KEY=

# Base API (par défaut https://v3.football.api-sports.io)
APISPORTS_BASE_URL=https://v3.football.api-sports.io

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase ---
# URL et clés du projet Supabase.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Clé service role : SERVEUR UNIQUEMENT (bypass RLS). Ne jamais exposer côté client.
SUPABASE_SERVICE_ROLE_KEY=

# --- Contraintes plan Free / cadence de refresh ---
# Intervalle de refresh live en secondes (jamais < 60s en plan Free).
API_REFRESH_INTERVAL_SECONDS=120

# Active les garde-fous du plan Free (cadence prudente, warnings limite).
SAFE_FREE_PLAN=true

# Quota journalier estimé du plan (Free = 100).
API_DAILY_QUOTA=100

# --- Filtrage Coupe du monde (valeurs par défaut, modifiables) ---
WORLD_CUP_LEAGUE_ID=1
WORLD_CUP_LEAGUE_NAME=World Cup
WORLD_CUP_SEASON=2026

# --- Sécurité cron (optionnel) ---
# Si défini, les routes /api/cron/* exigent ?secret=... ou header x-cron-secret.
CRON_SECRET=

# --- Source secondaire: commentaires live publics (OPTIONNEL, désactivé) ---
# Enrichissement uniquement. Ne déclenche jamais un signal fort seul.
ENABLE_PUBLIC_COMMENTARY_INGESTION=false
PUBLIC_COMMENTARY_REFRESH_INTERVAL_SECONDS=120

# --- Bot Telegram (worker indépendant: npm run worker) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Match par défaut auto-surveillé au démarrage du worker (optionnel).
FIXTURE_ID=1489378
MATCH_LABEL=Iran vs New Zealand
API_POLL_INTERVAL_SECONDS=30
MAX_API_CALLS_PER_DAY=7500
ENABLE_TELEGRAM_ALERTS=true
ENABLE_API_FOOTBALL_MONITOR=true
# Fichier d'état persistant (anti re-spam au redémarrage).
STATE_PATH=data/state.json

# --- Capteurs multi-sources (toutes PUBLIQUES, sans login/captcha) ---
# 1) Commentaires terrain (ultra-réactif, 5s). API-Football reste prioritaire.
ENABLE_COMMENTARY_SCRAPER=true
COMMENTARY_SOURCE_URL=
COMMENTARY_POLL_INTERVAL_SECONDS=5
# 2) Marché / cotes publiques.
ENABLE_MARKET_SCRAPER=true
MARKET_SOURCE_URL=
MARKET_POLL_INTERVAL_SECONDS=10
# 3) Compositions / blessures.
ENABLE_LINEUP_INJURY_SCRAPER=true
LINEUP_SOURCE_URL=
LINEUP_POLL_INTERVAL_SECONDS=300
# 4) News / contexte (URLs séparées par des virgules).
ENABLE_NEWS_CONTEXT_SCRAPER=true
NEWS_CONTEXT_SOURCE_URLS=
NEWS_CONTEXT_POLL_INTERVAL_SECONDS=900
# 5) Stats live alternatives (validation croisée, désactivé par défaut).
ENABLE_ALT_LIVE_STATS_SCRAPER=false
ALT_LIVE_STATS_SOURCE_URL=
ALT_LIVE_STATS_POLL_INTERVAL_SECONDS=30

# Rétro-compat (anciens noms du scraper commentaires):
# WINAMAX_MATCH_URL=
# WINAMAX_POLL_INTERVAL_SECONDS=5
# ENABLE_WINAMAX_COMMENTARY_WATCHER=true

# --- Surveillance live continue (live monitor) ---
# Active les "ticks" de surveillance. Rien ne tourne sans session de watch active.
ENABLE_LIVE_MONITOR=true
LIVE_POLL_INTERVAL_SECONDS=180
STATS_POLL_INTERVAL_SECONDS=180
EVENTS_POLL_INTERVAL_SECONDS=360
LINEUPS_SYNC_ONCE=true
CONTEXT_SYNC_ONCE=true
MAX_API_CALLS_PER_DAY=100

# --- Alertes WhatsApp (optionnelles, désactivées par défaut) ---
# provider: webhook (POST {text} vers WHATSAPP_WEBHOOK_URL) | twilio | meta
ENABLE_WHATSAPP_ALERTS=false
WHATSAPP_PROVIDER=webhook
WHATSAPP_WEBHOOK_URL=
WHATSAPP_TO=
# Délai minimum entre 2 alertes similaires (anti-spam).
WHATSAPP_ALERT_MIN_INTERVAL_SECONDS=180
# Twilio (si WHATSAPP_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
# Meta Cloud API (si WHATSAPP_PROVIDER=meta)
META_WHATSAPP_TOKEN=
META_WHATSAPP_PHONE_ID=

# --- IA optionnelle (désactivée par défaut) ---
# Si false ou pas de clé: le moteur maison fonctionne seul.
# L'IA ne fait que REFORMULER le conseil calculé (elle ne décide pas).
ENABLE_AI_ANALYSIS=false
AI_PROVIDER=anthropic
# Optionnel: surcharge du modèle (défaut anthropic: claude-sonnet-4-6).
AI_MODEL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
