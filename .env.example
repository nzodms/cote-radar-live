APISPORTS_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_BOT_LINK=https://t.me/CoteRadar_bot

# Optional default watch (laisser vide: le bot attend les commandes Telegram)
FIXTURE_ID=
MATCH_LABEL=

API_POLL_INTERVAL_SECONDS=30
COMMENTARY_POLL_INTERVAL_SECONDS=5
MARKET_POLL_INTERVAL_SECONDS=10
MAX_API_CALLS_PER_DAY=7500

ENABLE_TELEGRAM_ALERTS=true
ENABLE_API_FOOTBALL_MONITOR=true
ENABLE_COMMENTARY_SCRAPER=true
ENABLE_MARKET_SCRAPER=false

# Anti-spam
IMMEDIATE_ANALYSIS_COOLDOWN_SECONDS=10
MIN_SECONDS_BETWEEN_SIMILAR_ALERTS=120

# Optional per-match URLs (Winamax)
WINAMAX_MATCH_URL=
WINAMAX_MATCH_URL_66457006=
WINAMAX_MATCH_URL_66457018=

NODE_ENV=production
